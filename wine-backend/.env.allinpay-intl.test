# ============================================================
# Allinpay International (allinpayintl.com) TEST config
# Generated by gen-allinpay-intl-keys.ps1 -Env test
# Load: . scripts/set-allinpay-intl-env.ps1 -Env test
# ============================================================

# Spring profile
SPRING_PROFILES_ACTIVE=test

# ---- Allinpay International CNP ----
# Gateway base URL (test: https://test.allinpayhk.com/gateway)
ALLINPAY_INTL_BASE_URL=https://test.allinpayhk.com/gateway
# Merchant ID (15 digits, issued by Allinpay Intl)
ALLINPAY_INTL_MCHT_ID=MOCK_MCHT_ID_000
# Institution number (8 digits, issued by Allinpay Intl)
ALLINPAY_INTL_INST_NO=
# Currency: SGD for Singapore market
ALLINPAY_INTL_CURRENCY=SGD
# Mock mode (true=test without real gateway, false=production)
ALLINPAY_INTL_MOCK=true

# ---- RSA2 Keys ----
# Merchant private key (PKCS8 Base64) - for request signing (SHA256withRSA)
ALLINPAY_INTL_PRIVATE_
# Allinpay Intl public key (X.509 Base64) - for response/notify verification
# TEST: set to Allinpay Intl test public key (obtain from portal)
ALLINPAY_INTL_PUBLIC_KEY=MUST_SET_ALLINPAY_INTL_PUBLIC_KEY

# ---- Callback URLs ----
# Async notify URL (must be public HTTPS in prod)
ALLINPAY_INTL_NOTIFY_URL=http://localhost:8080/api/payment/notify
# Frontend redirect URL after payment
ALLINPAY_INTL_RETURN_URL=http://localhost:8080/payment/result

# ---- Transaction types (per Allinpay Intl spec Appendix A) ----
ALLINPAY_INTL_TRANS_TYPE_PURCHASE=Purchase
ALLINPAY_INTL_TRANS_TYPE_QUERY=Query
ALLINPAY_INTL_TRANS_TYPE_REFUND=Refund
